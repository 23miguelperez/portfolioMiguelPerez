---

<header id="main-header" class="header fixed z-50 top-0 left-0 right-0 flex items-center justify-between w-full p-4 shadow bg-[var(--primary-color)]/90">

    <div class="header-container flex items-center justify-between w-[90%] mx-auto relative">
        <p class="header-logo font-bold text-4xl">MP/&gt</p>

        <!-- Botón Hamburguesa: visible SOLO en móviles (hidden md:flex) -->
        <button id="menu-btn" class="flex md:hidden flex-col justify-between w-6 h-5 z-50 cursor-pointer" aria-label="Abrir menú">
            <span class="w-full h-0.5 bg-white transition-all duration-300 origin-left line-1"></span>
            <span class="w-full h-0.5 bg-white transition-all duration-300 line-2"></span>
            <span class="w-full h-0.5 bg-white transition-all duration-300 origin-left line-3"></span>
        </button>

        <!-- Navegación: Cambia drásticamente entre móvil y pantalla grande -->
        <nav id="menu-nav" class="header-nav fixed md:static top-0 right-0 w-[80%] h-screen py-20 px-8 md:py-1 md:h-auto md:w-auto bg-[var(--primary-color)]/90 md:bg-transparent
        flex flex-col md:flex-row md:items-center md:justify-center translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out">
            <ul class="nav-list flex flex-col md:flex-row gap-4 md:gap-8 md:gap-5 text-2xl md:text-sm items-end">
                <li class="nav-item opacity-80 hover:opacity-100 transition-opacity duration-300 hover:border-b-2 border-yellow-100"><a href="#inicio" class="nav-link">Inicio</a></li>
                <li class="nav-item opacity-80 hover:opacity-100 transition-opacity duration-300 hover:border-b-2 border-yellow-100"><a href="#experiencia" class="nav-link">Experiencia</a></li>
                <li class="nav-item opacity-80 hover:opacity-100 transition-opacity duration-300 hover:border-b-2 border-yellow-100"><a href="#proyectos" class="nav-link">Proyectos</a></li>
                <li class="nav-item opacity-80 hover:opacity-100 transition-opacity duration-300 hover:border-b-2 border-yellow-100"><a href="#contacto" class="nav-link">Contacto</a></li>
            </ul>
        </nav>
    </div>
</header>

<script>
    // Ejecutamos todo dentro del evento 'DOMContentLoaded' para asegurarnos de que el HTML ya existe
    document.addEventListener('DOMContentLoaded', () => {
        const header = document.getElementById('main-header');
        const menuBtn = document.getElementById('menu-btn');
        const menuNav = document.getElementById('menu-nav');
        const navLinks = document.querySelectorAll('.nav-link');

        // Función para alternar el menú
        function toggleMenu() {
            if (!menuNav || !menuBtn) return; // Validación de seguridad
            
            menuNav.classList.toggle('translate-x-full');
            
            // Usamos ?. para que si no encuentra la línea, no rompa la web
            menuBtn.querySelector('.line-1')?.classList.toggle('rotate-45');
            menuBtn.querySelector('.line-2')?.classList.toggle('opacity-0');
            menuBtn.querySelector('.line-3')?.classList.toggle('-rotate-45');
        }

        // Comprobamos de forma segura que el botón y el menú existen antes de asignar eventos
        if (menuBtn && menuNav) {
            menuBtn.addEventListener('click', toggleMenu);

            // Corregido 'Link' por 'link' para que coincida perfectamente
            navLinks.forEach(link => {
                link.addEventListener('click', () => {
                    if (!menuNav.classList.contains('translate-x-full')) {
                        toggleMenu();
                    }
                });
            });
        }

        // Lógica del Scroll (Opacidad del fondo)
        if (header) {
            window.addEventListener('scroll', () => {
                if (window.scrollY > 50) {
                    header.classList.replace('bg-[var(--primary-color)]/90', 'bg-[var(--primary-color)]/60');
                } else {
                    header.classList.replace('bg-[var(--primary-color)]/60', 'bg-[var(--primary-color)]/90');
                }
            });
        }
    });
</script>


